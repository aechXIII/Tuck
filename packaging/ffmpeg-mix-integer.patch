+static int mix_frames_integer(AVFilterContext *ctx, void *arg, int jobnr, int nb_jobs)
+{
+    MixContext *s = ctx->priv;
+    ThreadData *td = arg;
+    uint8_t **src = s->data + jobnr * s->nb_inputs;
+    int *stride = s->linesize + jobnr * s->nb_inputs;
+
+    for (int p = 0; p < s->nb_planes; p++) {
+        const int start = s->height[p] * jobnr / nb_jobs;
+        const int end = s->height[p] * (jobnr + 1) / nb_jobs;
+        uint8_t *dst = td->out->data[p] + start * td->out->linesize[p];
+
+        if (!((1 << p) & s->planes)) {
+            av_image_copy_plane(dst, td->out->linesize[p],
+                                td->in[0]->data[p] + start * td->in[0]->linesize[p],
+                                td->in[0]->linesize[p], s->linesizes[p], end - start);
+            continue;
+        }
+        for (int i = 0; i < s->nb_inputs; i++) {
+            stride[i] = td->in[i]->linesize[p];
+            src[i] = td->in[i]->data[p] + start * stride[i];
+        }
+        for (int y = start; y < end; y++) {
+            s->mix_line_integer(dst, src, s->nb_inputs, s->linesizes[p]);
+            dst += td->out->linesize[p];
+            for (int i = 0; i < s->nb_inputs; i++)
+                src[i] += stride[i];
+        }
+    }
+    return 0;
+}
