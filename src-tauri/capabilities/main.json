{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Allows the main window to use typed backend and native desktop commands with least privilege.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:window:allow-close",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "clipboard-manager:allow-write-text",
    "allow-backend-request",
    "allow-native-commands",
    "allow-app-lifecycle",
    "allow-window-chrome",
    "allow-desktop-preferences",
    "allow-preview-surface",
    "allow-native-player",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}