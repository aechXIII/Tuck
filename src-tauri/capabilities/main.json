{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Allows the main window to use typed backend and native desktop commands with least privilege.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:window:allow-close",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:default",
    "clipboard-manager:allow-write-text",
    "allow-backend-request",
    "allow-native-commands"
  ]
}