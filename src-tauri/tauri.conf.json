{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tuck",
  "version": "0.5.1",
  "identifier": "com.tuck.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tuck",
        "width": 1240,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "dragDropEnabled": true,
        "devtools": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:5173 ipc: http://ipc.localhost; img-src 'self' http://127.0.0.1:* asset: http://asset.localhost; media-src 'self' http://127.0.0.1:* asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "aechXIII",
    "homepage": "https://github.com/aechXIII/Tuck",
    "licenseFile": "../LICENSE"
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/aechXIII/Tuck/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1NDlERTg1MDQ3M0U5NjcKUldSbjZYTUVoZDVKaGF5RmxJU0tDRDNPZDc4Mm9xcjJTUTI2cVlERXVNa0YwOXhjVFY4YWRQNjMK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
